# RabbitMQ Configuration
AMQP_URL=amqp://guest:guest@localhost/
RPC_TIMEOUT=30.0

# Gateway Configuration
SERVICE_NAME=gateway
HOST=0.0.0.0
PORT=8000

# Redis cache (cache-aside)
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_TASK=60
CACHE_TTL_TAGS=300
CACHE_TTL_TASKS_LIST=20

# Rate limiting (token-bucket, per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_RATE=10

# Metrics (Prometheus exposition at /metrics)
METRICS_ENABLED=true

# Authentication (session cookie backed by Redis)
AUTH_ENABLED=true
SESSION_TTL=86400
SESSION_COOKIE_NAME=session
COOKIE_SECURE=false

# Yandex OAuth (register the app at https://oauth.yandex.ru; leave both
# credentials empty to disable the "Login with Yandex" flow)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8000/auth/yandex/callback
# Override the endpoints only in tests (points the flow at a mock server)
#YANDEX_OAUTH_BASE_URL=https://oauth.yandex.ru
#YANDEX_USERINFO_URL=https://login.yandex.ru/info
OAUTH_STATE_TTL=600
OAUTH_HTTP_TIMEOUT=10.0

# Chat (WebSocket + Redis pub/sub, one shared room)
CHAT_ENABLED=true
CHAT_CHANNEL=chat:general
CHAT_HISTORY_SIZE=50
CHAT_HEARTBEAT_INTERVAL=25
CHAT_HEARTBEAT_TIMEOUT=60
CHAT_MAX_MESSAGE_LENGTH=1000

# Logging
LOG_LEVEL=INFO
